{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -qE 'rm -rf /| -rf ~| -rf \\$HOME|DROP TABLE|DROP DATABASE|truncate.*tracking\\.|truncate.*core\\.|truncate.*static\\.|truncate.*intelligence\\.|alembic downgrade base|docker volume rm|docker compose down -v|--force-with-lease|git reset --hard origin' && { echo 'blocked: destructive command' >&2; exit 2; } || exit 0"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-and-lint.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/graphify-update.sh"
          }
        ]
      }
    ]
  }
}
