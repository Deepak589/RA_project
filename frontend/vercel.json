  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ra-project-5a1m.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://ra-project-5a1m.onrender.com"
    }
  }
}
